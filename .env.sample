# Adwize Audit — environment configuration.
# Copy to `.env` (which is gitignored) and fill in what you need:
#   cp .env.sample .env
# The CLI loads `.env` automatically on startup.

# ── Analysis agent (optional) ────────────────────────────────────────────────
# The site-analysis agent runs ONLY when this is set. Without it, scans still
# produce the full deterministic report — just no LLM narrative/recommendations.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model selection (all optional). Precedence per agent:
#   ADWIZE_MODEL_<AGENT>  >  ADWIZE_OPENAI_MODEL (global)  >  built-in default.
# Built-in defaults: analyst=gpt-4o (reasoning), schema_maintainer=gpt-4o-mini.
# ADWIZE_MODEL_ANALYST=gpt-4o
# ADWIZE_MODEL_SCHEMA_MAINTAINER=gpt-4o-mini
# ADWIZE_OPENAI_MODEL=gpt-4o-mini   # global override for every agent

# ── Storage (optional) ───────────────────────────────────────────────────────
# Default: local SQLite at ~/.adwize/audit.db.
# Set a Postgres URL to use a shared store (analyst edition).
# ADWIZE_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/adwize
# ADWIZE_DATA_DIR=~/.adwize

# ── Schemas (optional) ───────────────────────────────────────────────────────
# Where the schema-maintainer agent writes updated YAML schemas. When unset,
# the committed core/schemas/*.yaml are used as the last-known-good fallback.
# ADWIZE_SCHEMA_DIR=~/.adwize/schemas
